      "categories": [
        {
          "title": "1.1 Saluti di Sopravvivenza",
          "title_ar": "1.1 تحيات أساسية",
          "phrases": [
            { "text": "Buongiorno! (Fino alle 13:00)", "meaning": "صباح الخير! (لحد الساعة 1 الظهر)", "pronounce": "بون-جورنو" },
            { "text": "Buon pomeriggio!", "meaning": "طاب مساؤك! (بعد الظهر)", "pronounce": "بون بوميريدچو" },
            { "text": "Buonasera! (Dopo le 16:00)", "meaning": "مساء الخير! (بعد الساعة 4 العصر)", "pronounce": "بونا-سيرا" },
            { "text": "Bentornati a casa!", "meaning": "مرحباً بعودتكم لبيتكم!", "pronounce": "بين-تورناتي آ كازا" },
            { "text": "Ciao! (Bambini/Amici)", "meaning": "أهلاً! (للأطفال/الأصدقاء)", "pronounce": "تشاو" },
            { "text": "Benvenuti! (Plurale)", "meaning": "مرحباً بكم! (للجمع)", "pronounce": "بين-فينوتي" },
            { "text": "Come stai? / Come state?", "meaning": "كيف حالك؟ / كيف حالكم؟", "pronounce": "كومي ستاي / كومي ستاتي" },
            { "text": "Tutto bene?", "meaning": "كله تمام؟", "pronounce": "توتو بيني؟" },
            { "text": "Grazie.", "meaning": "شكراً.", "pronounce": "جراتسي" },
            { "text": "Prego / Di nulla.", "meaning": "عفواً / لا شكر على واجب.", "pronounce": "بريجو / دي نولا" },
            { "text": "Mi chiamo...", "meaning": "اسمي...", "pronounce": "مي كيامو..." },
            { "text": "Scusi / Scusa.", "meaning": "لو سمحت / عذراً.", "pronounce": "سكوزي / سكوزا" }
          ]
        },
        {
          "title": "1.2 Rompere il Ghiaccio",
          "title_ar": "1.2 كسر الجليد (فتح كلام)",
          "phrases": [
            { "text": "Che bel sole oggi, vero?", "meaning": "الجو شمس وجميل النهاردة، صح؟", "pronounce": "كي بيل سولي أودچي، فيرو؟" },
            { "text": "È la vostra prima volta a Marsa Alam?", "meaning": "أول مرة ليكم في مرسى علم؟", "pronounce": "إي لا فوسترا بريما فولتا آ مارسا ألام؟" },
            { "text": "Da quale parte dell'Italia venite?", "meaning": "من أي مكان في إيطاليا جايين؟", "pronounce": "دا كوالي بارتي ديل-إيتاليا فينيتي؟" },
            { "text": "È la prima volta in Egitto?", "meaning": "أول مرة في مصر؟", "pronounce": "إي لا بريما فولتا إن إيدچيتو؟" },
            { "text": "Quanto tempo rimanete con noi?", "meaning": "هتقعدوا معانا قد إيه؟", "pronounce": "كوانتو تيمبو ريمانيتي كون نوي؟" },
            { "text": "Avete provato il Mango / il Mare / la Discoteca?", "meaning": "جربتوا المانجة / البحر / الديسكو؟", "pronounce": "أفيتي بروفاتو إيل مانجو / إيل ماري / لا ديسكوتيكا؟" },
            { "text": "Vi piace l'hotel?", "meaning": "عاجبكم الفندق؟", "pronounce": "في بياتشي لوتيل؟" },
            { "text": "Avete già provato le attività?", "meaning": "جربتوا الأنشطة؟", "pronounce": "أفيتي دچا بروفاتو لي أتيفيتا؟" },
            { "text": "Di dove siete?", "meaning": "إنتو منين؟", "pronounce": "دي دوفي سيتي؟" }
          ]
        },
        {
          "title": "1.3 Presentazioni e Vibes",
          "title_ar": "1.3 التعارف والطاقة (Vibes)",
          "phrases": [
            { "text": "Buongiorno ragazzi! Come state oggi? Sono Amar dell'Animazione.", "meaning": "صباح الخير يا شباب! عاملين إيه النهاردة؟ أنا عمار من الأنيميشن.", "pronounce": "بونجورنو راجاتسي! كومي ستاتي أودچي؟ سونو أمار ديل-أنيماتسيوني." },
            { "text": "Ciao, Buongiorno! Sono Amar del team di Animazione.", "meaning": "أهلاً، صباح الخير! أنا عمار من فريق الأنيميشن.", "pronounce": "تشاو، بونجورنو! سونو أمار ديل تيم دي أنيماتسيوني." },
            { "text": "Ciao! Sono Amar, dell'Animazione.", "meaning": "أهلاً! أنا عمار، من الأنيميشن.", "pronounce": "تشاو! سونو أمار، ديل-أنيماتسيوني." },
            { "text": "Buon pomeriggio, benvenuti alla nostra spa. Mi chiamo Amar.", "meaning": "طاب مساؤكم، مرحباً بكم في السبا الخاص بنا. اسمي عمار.", "pronounce": "بون بوميريدچو، بينفينوتي آلا نوسترا سبا. مي كيامو أمار." },
            { "text": "Rendete l'atmosfera migliore, davvero!", "meaning": "إنتو محلين الجو، بجد!", "pronounce": "رينديتي لـ أتموسفيرا ميليوري، دافيرو!" },
            { "text": "Mi piace la vostra energia!", "meaning": "عجباني طاقتكم!", "pronounce": "مي بياتشي لا فوسترا إينيردچيا!" },
            { "text": "Avete una bella energia (Vibe).", "meaning": "طاقتكم (الڤايب) حلوة جداً.", "pronounce": "أفيتي أونا بيلا إينيردچيا." }
          ]
        },
        {
          "title": "1.4 Flirting e Complimenti (Sicuri)",
          "title_ar": "1.4 مجاملات لطيفة (آمنة)",
          "phrases": [
            { "text": "Dov'è il tuo sorriso? Ah, eccolo!", "meaning": "فين ابتسامتك؟ آه، أهي!", "pronounce": "دوف-إي إيل تو سوريزو؟ آ، إيكولو!" },
            { "text": "Oggi sei il campione della piscina.", "meaning": "إنت بطل حمام السباحة النهاردة.", "pronounce": "أودچي سي إيل كامبيوني ديلا بيشينا." },
            { "text": "Wow, che bella abbronzatura!", "meaning": "واو، تان جميل جداً!", "pronounce": "واو، كي بيلا أبرونزاتورا!" },
            { "text": "Mi piacciono i tuoi occhiali, molto eleganti!", "meaning": "نظارتك عجباني، شيك جداً!", "pronounce": "مي بياتشونو إي توي أوكيالي، مولتو إيليجانتي!" },
            { "text": "Avete una bellissima famiglia.", "meaning": "عيلتكم جميلة جداً.", "pronounce": "أفيتي أونا بيليسيما فاميليا." }
          ]
        }
